    {
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate this sales quote request as a pricing specialist.\n\nQuote ID: {{ $json.quote_id }}\nCustomer: {{ $json.customer_name }}\nProduct: {{ $json.product }}\nQuantity: {{ $json.quantity }}\nList unit price: {{ $json.list_unit_price }}\nDiscount percent: {{ $json.discount_percent }}\nStated quote value: {{ $json.quote_value }}\nRegion: {{ $json.region }}\nPayment terms: {{ $json.payment_terms }}\nNotes: {{ $json.notes }}\n\nCompute the correct discounted total, report the effective discount, list any pricing risk flags (e.g. total mismatch, unusually high discount, extended payment terms), summarize concisely, and give a preliminary recommendation.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the Evaluator Agent, a pricing specialist in a multi-agent quote-approval system. Your job is ONLY to analyze and characterize the quote (math, discount, risks) — you do NOT make the final approval decision; a separate Auditor Agent does. Be objective and concise. Always return output matching the required JSON schema.",
          "maxIterations": 5
        }
      },
      "id": "f79fd937-5ee0-4ce7-a211-a9d18c4fa01f",
      "name": "Evaluator Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {
          "maxOutputTokens": 512,
          "temperature": 0
        }
      },
      "id": "e9d3ed8a-20f5-444e-97e0-5b8c6e1d7bb5",
      "name": "Evaluator Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        464,
        336
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "GyUgk15GB3craAwS",
          "name": "Google Gemini API account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"calculated_total\":{\"type\":\"number\",\"description\":\"quantity * list_unit_price * (1 - discount_percent/100)\"},\"effective_discount_percent\":{\"type\":\"number\"},\"evaluator_recommendation\":{\"type\":\"string\",\"enum\":[\"APPROVE\",\"REVIEW\"]},\"risk_flags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"evaluation_summary\":{\"type\":\"string\"}},\"required\":[\"calculated_total\",\"effective_discount_percent\",\"evaluator_recommendation\",\"risk_flags\",\"evaluation_summary\"],\"additionalProperties\":false}"
      },
