    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Audit this quote against the business rules and return a final decision of exactly APPROVED or MANUAL_REVIEW.\n\nQuote ID: {{ $json.quote_id }}\nCustomer: {{ $json.customer_name }}\nProduct: {{ $json.product }}\nQuantity: {{ $json.quantity }}\nDiscount percent: {{ $json.discount_percent }}\nQuote value: {{ $json.quote_value }}\nRegion: {{ $json.region }}\nPayment terms: {{ $json.payment_terms }}\nEvaluator recommendation: {{ $json.evaluator_recommendation }}\nEvaluator calculated total: {{ $json.evaluator_calculated_total }}\nEvaluator effective discount: {{ $json.evaluator_effective_discount }}\nEvaluator summary: {{ $json.evaluator_summary }}\nEvaluator risk flags: {{ $json.evaluator_risk_flags }}\n\nApply these business rules:\n1. Discount percent must be <= 20%.\n2. Quote value must be <= 50000.\n3. Payment terms must be one of: Prepaid, Net 15, Net 30.\n4. Quantity must be greater than 0.\n5. Evaluator calculated total must match the stated quote value (within 1%).\nIf ALL rules pass, decision = APPROVED. If ANY rule fails, decision = MANUAL_REVIEW and list each violation.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the Auditor Agent, an independent compliance auditor in a multi-agent quote-approval system. You receive structured context produced by the Evaluator Agent and enforce the business rules strictly. The decision field MUST be exactly \"APPROVED\" or \"MANUAL_REVIEW\" — never any other value. When uncertain or when data is missing or inconsistent, choose MANUAL_REVIEW. Always return output matching the required JSON schema.",
          "maxIterations": 5
        }
      },
      "id": "d10761e4-d713-4495-bb43-000b5121e5b3",
      "name": "Auditor Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1024,
        112
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {
          "maxOutputTokens": 512,
          "temperature": 0
        }
      },
      "id": "45e0bf80-1604-4898-9fd1-83a5ea5805ac",
      "name": "Auditor Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        1040,
        336
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "GyUgk15GB3craAwS",
          "name": "Google Gemini API account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"decision\":{\"type\":\"string\",\"enum\":[\"APPROVED\",\"MANUAL_REVIEW\"]},\"rule_violations\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"reasons\":{\"type\":\"string\"}},\"required\":[\"decision\",\"rule_violations\",\"reasons\"],\"additionalProperties\":false}"
      },
      "id": "421c9cdd-0a34-4bac-bc21-c92a17e111e9",
      "name": "Auditor Output Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1168,
        336
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const auditor = ($json.output && typeof $json.output === \"object\") ? $json.output : {};\nconst ctx = $(\"Context Handoff\").item.json;\n\n// Normalize raw auditor decision\nconst rawDecision = typeof auditor.decision === \"string\" ? auditor.decision.trim().toUpperCase() : \"\";\nconst isValidDecision = rawDecision === \"APPROVED\" || rawDecision === \"MANUAL_REVIEW\";\n\n// Deterministic business-rule validation (fail-safe guard)\nconst MAX_DISCOUNT = 20;\nconst MAX_QUOTE_VALUE = 50000;\nconst ALLOWED_TERMS = [\"PREPAID\", \"NET 15\", \"NET 30\"];\n\nconst discount = Number(ctx.discount_percent);\nconst quoteValue = Number(ctx.quote_value);\nconst quantity = Number(ctx.quantity);\nconst terms = String(ctx.payment_terms || \"\").trim().toUpperCase();\nconst evalTotal = Number(ctx.evaluator_calculated_total);\n\nconst violations = [];\nif (!Number.isFinite(discount) || discount > MAX_DISCOUNT) violations.push(\"discount_percent exceeds 20% or invalid\");\nif (!Number.isFinite(quoteValue) || quoteValue > MAX_QUOTE_VALUE) violations.push(\"quote_value exceeds 50000 or invalid\");\nif (!ALLOWED_TERMS.includes(terms)) violations.push(\"payment_terms not in allowed list\");\nif (!Number.isFinite(quantity) || quantity <= 0) violations.push(\"quantity must be greater than 0\");\nif (!Number.isFinite(evalTotal) || (Number.isFinite(quoteValue) && quoteValue > 0 && Math.abs(evalTotal - quoteValue) / quoteValue > 0.01)) violations.push(\"calculated total does not match quote value\");\n\nconst hardRulesPass = violations.length === 0;\n\n// Final decision logic:\n// - Invalid/malformed auditor output -> MANUAL_REVIEW (never Approved)\n// - Auditor said APPROVED but hard rules fail -> MANUAL_REVIEW (safety override)\n// - Otherwise honor a valid auditor decision\nlet finalDecision;\nlet decisionReason;\nif (!isValidDecision) {\n  finalDecision = \"MANUAL_REVIEW\";\n  decisionReason = \"Auditor output missing or malformed; routed to manual review by fail-safe guard.\";\n} else if (rawDecision === \"APPROVED\" && !hardRulesPass) {\n  finalDecision = \"MANUAL_REVIEW\";\n  decisionReason = \"Auditor approved but deterministic business-rule validation failed; overridden to manual review.\";\n} else {\n  finalDecision = rawDecision;\n  decisionReason = typeof auditor.reasons === \"string\" ? auditor.reasons : \"\";\n}\n\nreturn {\n  quote_id: ctx.quote_id,\n  customer_name: ctx.customer_name,\n  final_decision: finalDecision,\n  auditor_decision_raw: rawDecision || null,\n  auditor_valid: isValidDecision,\n  hard_rules_pass: hardRulesPass,\n  hard_rule_violations: violations,\n  auditor_rule_violations: Array.isArray(auditor.rule_violations) ? auditor.rule_violations : [],\n  decision_reason: decisionReason,\n  quote_value: quoteValue,\n  discount_percent: discount,\n  payment_terms: ctx.payment_terms,\n};"
      },
